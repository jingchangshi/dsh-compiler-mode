+  async retire(caller: Agent, targetName: string): Promise<RetireTeammateResult> {
+    if (this.lifecycle.disposed) throw new TeamError('Agent Teams service is disposing', 'TEAM_DISPOSED')
+    return await this.lifecycle.track(this.retireAdmitted(caller, targetName))
+  }
+
+  /** Perform one admission-checked retirement. */
+  private async retireAdmitted(caller: Agent, targetName: string): Promise<RetireTeammateResult> {
+    const membership = this.membership(caller)
+    if (membership.role !== 'lead') {
+      throw new TeamError('only the Team Lead can retire teammates', 'TEAM_LEAD_REQUIRED')
+    }
+    const { root } = membership
+    const name = targetName.trim()
+    if (name === 'lead') throw new TeamError('the Team Lead cannot retire itself', 'TEAM_INVALID_TARGET')
+    const initial = this.journal.state(root).members.find(candidate => candidate.name === name)
+    if (initial === undefined) throw new TeamError(`teammate "${name}" not found`, 'TEAM_MEMBER_NOT_FOUND')
+    // Idempotent: an already retired member has nothing left to reclaim.
+    if (initial.phase === 'retired') return { retired: true, target: name }
+    if (initial.phase === 'provisioning') {
+      throw new TeamError(`teammate "${name}" is still provisioning and cannot be retired`, 'TEAM_PROVISIONING_CONFLICT')
+    }
+    // A running turn would race the drain; reject with a distinct, actionable
+    // code so the caller interrupts first and retries, rather than treating a
+    // busy teammate as an invalid target.
+    const live = this.ctx.agents.get(initial.id)
+    if (live?.status === 'running') {
+      throw new TeamError(`teammate "${name}" is running; interrupt it before retiring`, 'TEAM_MEMBER_RUNNING')
+    }
+    // Release the child Session BEFORE the durable tombstone: a failure here
+    // leaves the member active (retryable), never retired while still live.
+    await this.stopTeammates(root, [initial.id])
+    await this.journal.transact(root.id, async () => {
+      const current = this.journal.state(root).members.find(candidate => candidate.id === initial.id)
+      // Re-read under the transaction lock: a concurrent retire already settled.
+      if (current === undefined || current.phase === 'retired') return
+      if (current.phase === 'provisioning') {
+        throw new TeamError(`teammate "${name}" is still provisioning and cannot be retired`, 'TEAM_PROVISIONING_CONFLICT')
+      }
+      const retired: TeamMemberSnapshot = { ...current, phase: 'retired' }
+      await this.journal.appendAndFlush(root, 'team/member', {
+        version: 3,
+        teamId: TeamId(root.id),
+        member: retired,
+      })
+    })
+    return { retired: true, target: name }
+  }
