@@ -67,8 +67,81 @@ export class TeamRoster {
     private readonly journal: TeamJournal,
     private readonly lifecycle: TeamRuntimeLifecycle,
     private readonly maxMembers: number,
+    private readonly options: { autoRetireFailed: boolean; memberIdleGraceMs: number } = {
+      autoRetireFailed: true,
+      memberIdleGraceMs: 0,
+    },
   ) {}
 
+  /** When each member last stopped running, and when this roster started. */
+  private readonly idleSince = new Map<string, number>()
+  private readonly startedAt = Date.now()
+
+  /** Record one member's turn status so idle time is measurable. */
+  noteAgentStatus(agent: Agent): void {
+    const membership = this.tryMembership(agent)
+    if (membership?.role !== 'teammate') return
+    if (agent.status === 'running') this.idleSince.delete(membership.id)
+    else if (!this.idleSince.has(membership.id)) this.idleSince.set(membership.id, Date.now())
+  }
+
+  /** Count roster entries that still consume a member slot. */
+  private nonRetiredCount(state: TeamState): number {
+    return state.members.filter(candidate => candidate.phase !== 'retired').length
+  }
+
+  /** The best member to retire to free one slot, if one is safely reclaimable. */
+  private reclaimCandidate(state: TeamState): TeamMemberSnapshot | undefined {
+    const owned = new Set(
+      state.tasks
+        .filter(task => task.status === 'pending' || task.status === 'in_progress')
+        .map(task => task.ownerId)
+        .filter((id): id is SessionId => id !== undefined),
+    )
+    const now = Date.now()
+    const candidates: TeamMemberSnapshot[] = []
+    for (const candidate of state.members) {
+      if (candidate.phase === 'retired' || candidate.phase === 'provisioning') continue
+      // A dead member never deserves a slot: fold it away regardless of idleness.
+      if (candidate.phase === 'failed') {
+        if (this.options.autoRetireFailed) candidates.push(candidate)
+        continue
+      }
+      // A live-but-idle member is reclaimed only after the grace period, and
+      // never while it owns an open task or is running a turn.
+      if (this.options.memberIdleGraceMs <= 0) continue
+      if (owned.has(candidate.id)) continue
+      if (this.ctx.agents.get(candidate.id)?.status === 'running') continue
+      const since = this.idleSince.get(candidate.id) ?? this.startedAt
+      if (now - since < this.options.memberIdleGraceMs) continue
+      candidates.push(candidate)
+    }
+    candidates.sort((left, right) => {
+      const leftDead = left.phase === 'failed' ? 0 : 1
+      const rightDead = right.phase === 'failed' ? 0 : 1
+      if (leftDead !== rightDead) return leftDead - rightDead
+      return (this.idleSince.get(left.id) ?? this.startedAt) - (this.idleSince.get(right.id) ?? this.startedAt)
+    })
+    return candidates[0]
+  }
+
+  /** Retire dead or long-idle, task-free members until one slot is free. */
+  private async reclaimForCapacity(caller: Agent, root: Agent): Promise<void> {
+    if (!this.options.autoRetireFailed && this.options.memberIdleGraceMs <= 0) return
+    for (let attempt = 0; attempt < 8; attempt += 1) {
+      const state = this.journal.state(root)
+      if (this.nonRetiredCount(state) < this.maxMembers) return
+      const victim = this.reclaimCandidate(state)
+      if (victim === undefined) return
+      try {
+        await this.retireAdmitted(caller, victim.name)
+      } catch {
+        // A racing change made the victim unreclaimable; stop rather than spin.
+        return
+      }
+    }
+  }
